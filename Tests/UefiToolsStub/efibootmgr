#!/usr/bin/env bash

set -euo pipefail

STATE_DIR="${APEX32_TEST_FIRMWARE_STATE:?}"
ORDER_FILE="${STATE_DIR}/order"
NEXT_FILE="${STATE_DIR}/next"
ENTRY_FILE="${STATE_DIR}/apex32-entry"
DUPLICATE_FILE="${STATE_DIR}/apex32-duplicate"
CREATE_COUNT_FILE="${STATE_DIR}/create-count"

show_state() {
  local order next
  order="$(<"$ORDER_FILE")"
  next=""
  [[ ! -f "$NEXT_FILE" ]] || next="$(<"$NEXT_FILE")"

  printf 'BootCurrent: 0006\n'
  [[ -z "$next" ]] || printf 'BootNext: %s\n' "$next"
  printf 'Timeout: 0 seconds\n'
  printf 'BootOrder: %s\n' "$order"
  printf 'Boot0006* rEFInd Boot Manager\tHD(1,GPT,stub)/\\EFI\\refind\\refind_x64.efi\n'
  printf 'Boot0002* BlackArch_Linux\tHD(1,GPT,stub)/\\EFI\\BlackArch_Linux\\grubx64.efi\n'
  printf 'Boot0003* kali\tHD(1,GPT,stub)/\\EFI\\kali\\grubx64.efi\n'
  [[ ! -f "$ENTRY_FILE" ]] || printf 'Boot0007* APEX32 Secure Gateway\tHD(1,GPT,stub)/\\EFI\\APEX32\\Apex32BootManager.efi\n'
  [[ ! -f "$DUPLICATE_FILE" ]] || printf 'Boot0008* APEX32 Secure Gateway\tHD(1,GPT,stub)/\\EFI\\APEX32\\Apex32BootManager.efi\n'
}

if [[ $# -eq 0 ]]; then
  show_state
  exit 0
fi

case "$1" in
  --create)
    [[ $# -eq 9 ]]
    [[ "$2" == "--disk" && "$3" == "/dev/nvme0n1" ]]
    [[ "$4" == "--part" && "$5" == "1" ]]
    [[ "$6" == "--label" && "$7" == "APEX32 Secure Gateway" ]]
    [[ "$8" == "--loader" && "$9" == '\EFI\APEX32\Apex32BootManager.efi' ]]
    create_count=0
    [[ ! -f "$CREATE_COUNT_FILE" ]] || create_count="$(<"$CREATE_COUNT_FILE")"
    printf '%s\n' "$((create_count + 1))" > "$CREATE_COUNT_FILE"
    : > "$ENTRY_FILE"
    printf '0007,%s\n' "$(<"$ORDER_FILE")" > "$ORDER_FILE"
    show_state
    ;;
  --bootorder)
    [[ $# -eq 2 ]] || exit 2
    printf '%s\n' "$2" > "$ORDER_FILE"
    ;;
  --bootnext)
    [[ $# -eq 2 ]] || exit 2
    printf '%s\n' "$2" > "$NEXT_FILE"
    ;;
  --delete-bootnext)
    [[ $# -eq 1 ]] || exit 2
    rm -f "$NEXT_FILE"
    ;;
  *)
    printf 'unexpected efibootmgr arguments: %s\n' "$*" >&2
    exit 2
    ;;
esac
